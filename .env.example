# Bybit API
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=false

# Supabase — FVG/OnChain project (same project, shared with FVG bot)
SUPABASE_URL=https://ayqxizcbgqnkbextndqb.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Paper trading
PAPER_TRADING=true
PAPER_BALANCE=10000

# On-chain data APIs
# Etherscan — free tier at https://etherscan.io/apis
# Activates: whaleTracker (USDT flows >$1M) and networkActivity ETH (gas price)
ETHERSCAN_API_KEY=your_etherscan_key_here

# Helius — free tier at https://www.helius.dev
# Activates: networkActivity SOL (transaction throughput)
HELIUS_API_KEY=your_helius_key_here

# Fear & Greed Index: NO API key required (used by exchangeNetflow collector)

# Bot mode
NODE_ENV=production
LOG_LEVEL=info
